{
  "name": "curio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB REST API for the Curio STEM learning platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test --experimental-test-module-mocks tests/unit/*.test.js",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=src/services/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/unit/*.test.js",
    "test:bdd": "cucumber-js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "mongodb-memory-server": "^10.2.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4"
  }
}
